{{!
    @template local_copyquestionbank/question_bank_group

    Dedicated visual group for native question bank backup settings.

    @copyright  2026 Marcelo M. Almeida Júnior
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Context variables required for this template:
    * grouplabel - Localised title for the question bank group.
    * userinfolabel - Localised title for the user data column.

    Example context (json):
    {
        "grouplabel": "Question Banks",
        "userinfolabel": "User data"
    }
}}
<div class="grouped_settings section_level"
    data-region="local-copyquestionbank-group"
    role="group"
    aria-label="{{grouplabel}}">
    <div class="include_setting section_level">
        <div class="fitem local-copyquestionbank-group-heading">
            <div class="fitemtitle">{{grouplabel}}</div>
        </div>
    </div>
    <div class="normal_setting">
        <div class="fitem local-copyquestionbank-group-heading">
            <div class="fitemtitle">{{userinfolabel}}</div>
        </div>
    </div>
</div>
